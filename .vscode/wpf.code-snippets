{
	// Place your PowershellStuff workspace snippets here. Each snippet is defined under a snippet name and has a scope, prefix, body and
	// description. Add comma separated ids of the languages where the snippet is applicable in the scope field. If scope
	// is left empty or omitted, the snippet gets applied to all languages. The prefix is what is
	// used to trigger the snippet and the body will be expanded and inserted. Possible variables are:
	// $1, $2 for tab stops, $0 for the final cursor position, and ${1:label}, ${2:another} for placeholders.
	// Placeholders with the same ids are connected.
	// Example:
	// "Print to console": {
	// 	"scope": "javascript,typescript",
	// 	"prefix": "log",
	// 	"body": [
	// 		"console.log('$1');",
	// 		"$2"
	// 	],
	// 	"description": "Log output to console"
	// }
	"Button": {
		"scope": "powershell",
		"prefix": "wpf-button",
		"description": "Button",
		"body": [
			"Button '${1:Name}' {",
			"\t\\$this.Content = '${2:Content}'",
			"\tOn ${4:Click} {",
			"\t\t${5:# TODO: event handler}",
			"\t}",
			"}"
		]
	},
	"DatePicker": {
		"scope": "powershell",
		"prefix": "wpf-datepicker",
		"description": "DatePicker",
		"body": [
			"DatePicker '${1:Name}' {",
			"\t\\$this.SelectedDate = [datetime]::Today",
			"\tOn ${2:SelectedDateChanged} {",
			"\t\t${3:# TODO: handle date change}",
			"\t}",
			"}"
		]
	},
	"Grid": {
		"scope": "powershell",
		"prefix": "wpf-grid",
		"description": "Grid",
		"body": [
			"Grid '${1:Body}' {",
			"\tRow {",
			"\t\tColumn {",
			"\t\t\tVStackPanel {",
			"\t\t\t\t\\${2:# Content}",
			"\t\t\t}",
			"\t\t}",
			"\t}",
			"}"
		]
	},
	"StackPanel": {
		"scope": "powershell",
		"prefix": "wpf-stackpanel",
		"description": "StackPanel",
		"body": [
			"StackPanel '${1:StackPanel}' {",
			"\t\\$this.Orientation = '${2|Vertical,Horizontal|}'",
			"",
			"\t\\${3:# Content}",
			"}"
		]
	},
	"Window": {
		"scope": "powershell",
		"prefix": "wpf-window",
		"description": "Window",
		"body": [
			"Window '${1:Name}' {",
			"\t\\$this.Title = '${2:Title}'",
			"\t\\$this.WindowStartupLocation = [WindowStartupLocation]::CenterScreen",
			"\t\\$this.Width = ${3:900}",
			"\t\\$this.Height = ${4:600}",
			"",
			"\t${5:# TODO: add content here}",
			"",
			"} | Show-WPFWindow"
		]
	},
	"App": {
		"scope": "powershell",
		"prefix": "wpf-app",
		"description": "App shell with Content/Footer/StatusBar",
		"body": [
			"App '${1:MainApp}' {",
			"\t\\$this.Title = '${2:Title}'",
			"\t\\$this.WindowStartupLocation = [WindowStartupLocation]::CenterScreen",
			"\tState @{}",
			"",
			"\tContent {",
			"\t\t${3:# TODO: add content here}",
			"\t}",
			"",
			"\tFooter {}",
			"",
			"\tStatusBar {}",
			"\t}",
			"} | Show-WPFWindow"
		]
	},
	"MenuItem Path": {
		"scope": "powershell",
		"prefix": "wpf-menuitem-path",
		"description": "MenuItem with path shorthand",
		"body": [
			"MenuItem '${1:_File/_Action}' {",
			"\tOn Click {",
			"\t\t${2:# TODO: menu action}",
			"\t}",
			"}"
		]
	},
	"DataGrid": {
		"scope": "powershell",
		"prefix": "wpf-datagrid",
		"description": "DataGrid with explicit columns",
		"body": [
			"DataGrid '${1:Name}' {",
			"\t\\$this.AutoGenerateColumns = \\$false",
			"\t\\$this.ItemsSource = ${2:Get-Process}",
			"",
			"\tDataGridTextColumn '${3:Name}' '${4:ProcessName}' {",
			"\t\t${5:# Optional column styling}",
			"\t}",
			"}"
		]
	},
	"DataGridTextColumn": {
		"scope": "powershell",
		"prefix": "wpf-datagrid-column",
		"description": "DataGridTextColumn with binding path",
		"body": [
			"DataGridTextColumn '${1:Header}' '${2:PropertyName}' {",
			"\t\\$this.Width = [System.Windows.Controls.DataGridLength]::new(${3:1}, [System.Windows.Controls.DataGridLengthUnitType]::Star)",
			"\t${4:# Optional styles}",
			"}"
		]
	},
	"Command": {
		"scope": "powershell",
		"prefix": "wpf-command",
		"description": "Command with optional gesture",
		"body": [
			"Command '${1:Action}' '${2:Gesture}' {",
			"\tExecute {",
			"\t\t${3:# TODO: execute logic}",
			"\t}",
			"\tCanExecute {",
			"\t\t${4:\\$true}",
			"\t}",
			"}"
		]
	},
	"Key Gesture": {
		"scope": "powershell",
		"prefix": "wpf-key",
		"description": "Key gesture handler (PreviewKeyDown sugar)",
		"body": [
			"Key '${1:KeyOrGesture}' {",
			"\t${2:# TODO: key action}",
			"}"
		]
	},
	"Link State Map": {
		"scope": "powershell",
		"prefix": "wpf-link-state-map",
		"description": "Link property to state with value map",
		"body": [
			"Link ${1:Text} -ToState ${2:IsBusy} -Map @{",
			"\t\\$true = '${3:Working...}'",
			"\t\\$false = '${4:Ready}'",
			"}"
		]
	},
	"Bind To State Path": {
		"scope": "powershell",
		"prefix": "wpf-bind-state",
		"description": "Bind property to state path",
		"body": [
			"Bind ${1:Visibility} -To Window.Tag.${2:IsBusy} ${3:-Invert}"
		]
	},
	"TimedEvent Async": {
		"scope": "powershell",
		"prefix": "wpf-timed-event",
		"description": "TimedEvent with Work and OnComplete",
		"body": [
			"TimedEvent '${1:Name}' ${2:3000} {",
			"\tWork {",
			"\t\t${3:Action}",
			"\t}",
			"\tOnComplete {",
			"\t\tparam(\\$Result, \\$Sender)",
			"\t\t${4:# TODO: update UI from result}",
			"\t}",
			"}"
		]
	}
}
