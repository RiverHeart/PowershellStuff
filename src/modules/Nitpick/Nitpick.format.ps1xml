<?xml version="1.0" encoding="utf-8" ?>
<Configuration>
  <ViewDefinitions>
    <View>
      <Name>NitpickSummary</Name>
      <ViewSelectedBy>
        <TypeName>NitpickSummary</TypeName>
      </ViewSelectedBy>
      <OutOfBand />
      <ListControl>
        <ListEntries>
          <ListEntry>
            <ListItems>
              <ListItem>
                <PropertyName>TargetCount</PropertyName>
              </ListItem>
              <ListItem>
                <PropertyName>RuleCount</PropertyName>
              </ListItem>
              <ListItem>
                <PropertyName>FindingCount</PropertyName>
              </ListItem>
              <ListItem>
                <PropertyName>ErrorCount</PropertyName>
              </ListItem>
              <ListItem>
                <PropertyName>WarningCount</PropertyName>
              </ListItem>
              <ListItem>
                <PropertyName>InformationCount</PropertyName>
              </ListItem>
              <ListItem>
                <PropertyName>Duration</PropertyName>
              </ListItem>
            </ListItems>
          </ListEntry>
        </ListEntries>
      </ListControl>
    </View>
  </ViewDefinitions>
</Configuration>
